# Keep all provider credentials server-side. Never commit a real key.
# Existing MovieBox access uses its signed backend client and does not need a browser key.
MOVIEBOX_SECRET_KEY_DEFAULT=
MOVIEBOX_SECRET_KEY_ALT=

# Optional: only for an API/source you own or are explicitly authorized to use.
AUTHORIZED_PROVIDER_BASE_URL=
AUTHORIZED_PROVIDER_API_KEY=
